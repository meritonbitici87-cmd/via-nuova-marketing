# Von Supabase (Connect-Button -> ORM -> Prisma). Unbedingt die Pooler-URLs nehmen, nicht
# die direkte Verbindung - die ist von serverlosem Hosting (Vercel) aus nicht erreichbar.
DATABASE_URL="postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:5432/postgres"

# Von console.anthropic.com -> API Keys
ANTHROPIC_API_KEY="sk-ant-..."

# Von platform.openai.com -> API Keys (nur für Bildgenerierung, /api/generate-image)
OPENAI_API_KEY="sk-..."

# Von Supabase (Projekt-Settings -> API), für den Storage-Bucket mit echten Foto-/Video-Uploads.
# SUPABASE_URL ist die "Project URL" (z.B. https://xyzcompany.supabase.co).
# SUPABASE_SERVICE_ROLE_KEY ist der "service_role"-Key (NICHT der "anon"-Key!) -
# hat volle Rechte und darf niemals im Frontend landen, nur serverseitig verwenden.
SUPABASE_URL="https://xyzcompany.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Öffentlich erreichbare URL deiner App (z.B. https://via-nuova-marketing.vercel.app).
# Wird gebraucht, damit Meta/Google Bilder & Videos von ihren Servern aus laden können
# (funktioniert nicht mit http://localhost).
SITE_URL="https://your-domain.example.com"

# Selbst frei erfundenes, langes Zufalls-Passwort. Schützt /api/social/publish-scheduled
# davor, dass jemand über die öffentliche URL beliebig Beiträge auslösen kann.
CRON_SECRET="ein-langes-zufaelliges-passwort"

# Von developers.facebook.com -> deine App -> Einstellungen -> Basis.
# Wird gebraucht, um Facebook/Instagram Access Tokens zu verlängern (long-lived Token)
# und Posting-Requests an die Meta Graph API zu signieren.
META_APP_ID="123456789"
META_APP_SECRET="..."

# Von console.cloud.google.com -> APIs & Dienste -> Anmeldedaten -> OAuth-Client-ID.
# Wird für die Google Business Profile API gebraucht (Login-Flow + Token-Refresh,
# da Google Access Tokens nur 1 Stunde gültig sind).
GOOGLE_CLIENT_ID="....apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="..."
